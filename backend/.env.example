DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
APP_ENV=production
CORS_ORIGIN=https://cf.hnchpower.cn
# CORS_EXTRA_ORIGINS=http://localhost:5173
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_HOURS=8
AUTH_BUILTIN_ACCOUNT=adam
# Only used once when the initial administrator record does not exist.
AUTH_BUILTIN_PASSWORDS=replace-with-a-strong-bootstrap-password
AUTH_COOKIE_DOMAIN=.hnchpower.cn
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
# 本地开发可用以下配置（HTTP）：
# APP_ENV=development
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax
AUTH_OTP_SALT=replace-with-random-otp-salt
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=login@dxyx6888.com
