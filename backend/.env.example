# 运行时优先 pooled。Neon 主机会被改写成 *-pooler；非 Neon 主机保持原样。
# 迁移使用 DATABASE_URL_DIRECT（或去掉 -pooler 的 DATABASE_URL）。占位符，不要写入真实密码。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require
# DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# QUICKSDK_DATABASE_URL 仅在 DATABASE_URL 为空时作为运行时主连接。
# QUICKSDK_DATABASE_URL=
# QUICKSDK_DATABASE_URL_POOLED=
# QUICKSDK_DATABASE_URL_DIRECT=
# APP_ENV=production 是明确的生产标记，不是缺省值。未设置 VERCEL_ENV 和 APP_ENV 时拒绝生产计算节点。
# 本地、预览、测试请改成 development/preview/test/staging，且不要填入 withered-mouse-06737032。
# 确需临时共用生产库时再设 ALLOW_SHARED_PRODUCTION_DATABASE=1。
APP_ENV=production
CORS_ORIGIN=https://cf.hnchpower.cn
# CORS_EXTRA_ORIGINS=http://localhost:5173
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_HOURS=8
AUTH_BUILTIN_ACCOUNT=adam
# Only used once when the initial administrator record does not exist.
AUTH_BUILTIN_PASSWORDS=replace-with-a-strong-bootstrap-password
AUTH_COOKIE_DOMAIN=.hnchpower.cn
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none
# 本地开发可用以下配置（HTTP）：
# APP_ENV=development
# AUTH_COOKIE_DOMAIN=
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=lax
AUTH_OTP_SALT=replace-with-random-otp-salt
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=login@dxyx6888.com
