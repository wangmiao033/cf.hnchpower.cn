{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "proxy/",
      "entrypoint": "main:app",
      "framework": "fastapi"
    },
    "core": {
      "root": "backend/",
      "entrypoint": "main:app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "core"
      }
    },
    {
      "source": "/health/db",
      "destination": {
        "service": "core"
      }
    },
    {
      "source": "/api/partners",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/partners/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/contracts",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/contracts/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/quicksdk/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/reconciliation-links/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "core"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "core"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
