{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "proxy/",
      "entrypoint": "secured_main:app",
      "framework": "fastapi"
    },
    "core": {
      "root": "backend/",
      "entrypoint": "main:app",
      "framework": "fastapi"
    },
    "contract_ai": {
      "root": "contract_ai/",
      "entrypoint": "secured_main:app",
      "framework": "fastapi"
    },
    "contract_terms": {
      "root": "contract_terms/",
      "entrypoint": "v10_main:app",
      "framework": "fastapi"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/health/db",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "core"
      }
    },
    {
      "source": "/health/db",
      "destination": {
        "service": "core"
      }
    },
    {
      "source": "/api/partners",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/partners/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/contracts/smart-scan",
      "destination": {
        "service": "contract_ai"
      }
    },
    {
      "source": "/api/contracts/internal-numbers",
      "destination": {
        "service": "contract_ai"
      }
    },
    {
      "source": "/api/contracts",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/contracts/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/contract-terms",
      "destination": {
        "service": "contract_terms"
      }
    },
    {
      "source": "/api/contract-terms/(.*)",
      "destination": {
        "service": "contract_terms"
      }
    },
    {
      "source": "/api/quicksdk/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/reconciliation-links/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "core"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "core"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
