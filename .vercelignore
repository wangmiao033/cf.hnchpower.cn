# =============================================================================
# Vercel Ignore - Reduce Functions Storage Size
# =============================================================================
# This file excludes unnecessary files from Vercel serverless function bundles
# to reduce Functions Storage usage.

# -----------------------------------------------------------------------------
# Test files - not needed in production
# -----------------------------------------------------------------------------
**/*test*.py
**/*_test.py
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
**/tests/
**/test/
**/__tests__/
**/conftest.py
pytest.ini
.pytest_cache/
coverage/
.coverage
htmlcov/

# -----------------------------------------------------------------------------
# Development and build artifacts
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node.js development files
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -----------------------------------------------------------------------------
# Documentation and examples (not needed at runtime)
# -----------------------------------------------------------------------------
docs/
*.md
!README.md
LICENSE*
CHANGELOG*
CONTRIBUTING*
examples/
samples/

# -----------------------------------------------------------------------------
# IDE and editor files
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.editorconfig

# -----------------------------------------------------------------------------
# Git and version control
# -----------------------------------------------------------------------------
.git/
.gitignore
.gitattributes

# -----------------------------------------------------------------------------
# CI/CD configuration
# -----------------------------------------------------------------------------
.github/
.gitlab-ci.yml
.travis.yml
Makefile
Dockerfile*
docker-compose*
.dockerignore

# -----------------------------------------------------------------------------
# Environment and secrets (should already be excluded)
# -----------------------------------------------------------------------------
.env*
!.env.example
*.local

# -----------------------------------------------------------------------------
# Temporary and cache files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
.cache/
.tmp/
tmp/
temp/

# -----------------------------------------------------------------------------
# Type stubs and type checking artifacts
# -----------------------------------------------------------------------------
*.pyi
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# -----------------------------------------------------------------------------
# NOTE: scripts/patch-*.mjs are NOT excluded because they are required
# during Vercel's prebuild phase (see package.json "prebuild" script).
# The vercel-production-build-v2.sh script is also needed at build time.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Large static assets that shouldn't be in functions
# -----------------------------------------------------------------------------
*.pdf
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.mp4
*.mov
*.mp3
*.wav
*.zip
*.tar
*.gz
*.rar

# -----------------------------------------------------------------------------
# Backend development files
# -----------------------------------------------------------------------------
backend/var/
backend/uploads/
backend/.env*
backend/README.md
backend/Procfile

# Proxy service development files  
proxy/.env*

# Contract AI development files
contract_ai/.env*
contract_ai/test_*.py

# Contract Terms development files
contract_terms/.env*
contract_terms/test_*.py
