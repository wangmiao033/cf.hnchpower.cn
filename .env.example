# -----------------------------------------------------------------------------
#  duizhang2025 — 环境变量模板
#  复制为 .env 后按需填写；不要提交包含真实密钥的 .env
# -----------------------------------------------------------------------------

# 前端请求后端 API 的基地址（Vite：须以 VITE_ 开头）
VITE_API_BASE_URL=https://caiwuapi.hnchpower.cn

# Neon PostgreSQL
# 运行时读取 DATABASE_URL；若为空则读取 QUICKSDK_DATABASE_URL。
# 两者都指向 Neon 时，应用会自动改写成带 -pooler 的主机，不必手写两套密码。
# 显式 pooled 只覆盖当前选中的主连接：设了 DATABASE_URL 时用 DATABASE_URL_POOLED，
# 只设了 QUICKSDK_DATABASE_URL 时才用 QUICKSDK_DATABASE_URL_POOLED。
# 迁移（MIGRATION_EXECUTION_CONTEXT=deploy|manual|cli）使用 *_DIRECT，并去掉 -pooler。
# 生产计算节点 withered-mouse-06737032 默认拒绝。
# 只有 VERCEL_ENV=production 或 APP_ENV=production 可以连接；未设置这两个变量不算生产。
# 下面的 development 是本地默认。APP_ENV=production 只用于真正的 Production，不要在本地改成那一行。
# 使用 Neon 分支，不要把生产连接串写入仓库。
# 临时共用生产库时才设置 ALLOW_SHARED_PRODUCTION_DATABASE=1。
APP_ENV=development
# APP_ENV=production
DATABASE_URL=
DATABASE_URL_POOLED=
DATABASE_URL_DIRECT=
QUICKSDK_DATABASE_URL=
QUICKSDK_DATABASE_URL_POOLED=
QUICKSDK_DATABASE_URL_DIRECT=
# ALLOW_SHARED_PRODUCTION_DATABASE=

# 合同 AI：可选的外部 PDF 渲染服务。
# Phase 1 中未配置或调用失败时会自动回退到现有 Vercel 本地渲染，
# 因此不配置这两个变量时，现有合同扫描行为保持不变。
PDF_RENDERER_URL=
PDF_RENDERER_TOKEN=
